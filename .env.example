# SentinelX environment configuration. Copy to `.env` and fill in.
# NEVER commit a real .env. Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Core ---
ENVIRONMENT=development           # development | test | production
SECRET_KEY=                       # REQUIRED in production; auto-generated in dev

# --- Database ---
# Local dev default is SQLite (no external service). docker-compose uses Postgres.
DATABASE_URL=sqlite:///./sentinelx.db
# DATABASE_URL=postgresql+psycopg://sentinelx:sentinelx@db:5432/sentinelx

# --- Background processing ---
# Leave REDIS_URL empty for eager, in-process task execution (dev/test).
REDIS_URL=

# --- Postgres (docker-compose) ---
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinelx

# --- Auth / tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Scan safety ---
# Enable ONLY for an authorized local lab; allows scanning private/loopback IPs.
ALLOW_PRIVATE_SCAN_TARGETS=false
SCAN_MAX_PAGES=100
SCAN_MAX_CONCURRENCY=4
SCAN_REQUESTS_PER_SECOND=8
SCAN_TIMEOUT_SECONDS=20
SCAN_HARD_DEADLINE_SECONDS=900

# --- AI analyst (optional; deterministic analyst used when disabled) ---
AI_ENABLED=false
AI_PROVIDER=none                  # none | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
